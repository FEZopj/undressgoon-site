# The site-wide rule marks images "immutable" for a week, which is right for
# assets whose URL changes when they change. These do NOT: an example pair is
# swapped in place under the same a1/a2 names, so an immutable cache keeps
# serving the old picture (and shows before/after reversed) for days.
<IfModule mod_headers.c>
  <FilesMatch "\.(jpe?g|png|webp)$">
    Header set Cache-Control "public, max-age=300, must-revalidate"
  </FilesMatch>
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/png "access plus 5 minutes"
  ExpiresByType image/jpeg "access plus 5 minutes"
  ExpiresByType image/webp "access plus 5 minutes"
</IfModule>
