# Never expose a browsable directory listing. This previously made the obsolete
# /results/ and /results/thumbs/ directories public.
<IfModule mod_autoindex.c>
  Options -Indexes
</IfModule>

# Performance: long-cache heavy media, keep CSS/JS easy to refresh during launches
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/png "access plus 7 days"
  ExpiresByType image/x-icon "access plus 7 days"
  ExpiresByType application/manifest+json "access plus 7 days"
  ExpiresByType text/css "access plus 5 minutes"
  ExpiresByType application/javascript "access plus 5 minutes"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(webp|png|ico|webmanifest)$">
    Header set Cache-Control "public, max-age=604800, immutable"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=300, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(html)$">
    Header set Cache-Control "public, max-age=300"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set X-Frame-Options "DENY"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob: https://api.undressgoon.app; connect-src 'self' https://api.undressgoon.app https://us.i.posthog.com https://eu.i.posthog.com https://app.posthog.com; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self' mailto:"
</IfModule>

# Prefer compressed transfer when available
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json
</IfModule>

# WebP MIME
<IfModule mod_mime.c>
  AddDefaultCharset UTF-8
  AddType image/webp .webp
  AddType image/x-icon .ico
  AddType application/manifest+json .webmanifest
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # One public URL per page: HTTPS, apex domain, directory form (no index.html).
  # Handle index.html first so even http://www/.../index.html reaches the final
  # canonical URL in a single permanent redirect.
  RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html(?:[?\s]) [NC]
  RewriteRule ^(.*/)?index\.html$ https://undressgoon.app/$1 [R=301,L,NE]

  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} !^undressgoon\.app$ [NC]
  RewriteRule ^ https://undressgoon.app%{REQUEST_URI} [R=301,L,NE]

  # The old public result gallery is gone. A real 410 prevents auto-index query
  # variants such as ?MD, ?MA and /thumbs/?NA from becoming crawlable pages.
  RewriteRule ^results(?:/|$) - [G,L,NC]

  RewriteRule ^terms/?$ terms.html [L]
  RewriteRule ^privacy/?$ privacy.html [L]
  RewriteRule ^acceptable-use/?$ acceptable-use.html [L]
  RewriteRule ^consent/?$ consent.html [L]
  RewriteRule ^refunds/?$ refunds.html [L]
  RewriteRule ^dmca/?$ dmca.html [L]
  RewriteRule ^report-abuse/?$ report-abuse.html [L]
  RewriteRule ^contact/?$ contact.html [L]
  RewriteRule ^age-safety/?$ age-safety.html [L]
  # lp2 became the index; keep any live ad or bookmark pointing at it working
  RewriteRule ^lp2\.html$ / [R=301,L]
  RewriteRule ^(es|pt|fr|de|ru|zh|ja)/lp2\.html$ /$1/ [R=301,L]
  RewriteRule ^trafficstars/?$ trafficstars/index.html [L]
  RewriteRule ^goon/?$ trafficstars/index.html [L]
</IfModule>
